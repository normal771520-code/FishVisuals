{
  "id": "fish-visuals",
  "name": "FishVisuals",
  "version": "1.0",
  "author": "Normal48",
  "description": "Визуалы а еще я рыбу не люблю",
  "libs": ["libs/arm64-v8a/libfishvisuals.so"],
  "settings": [
    { "id": "enable_chroma", "type": "bool", "name": "Хрома-скин (Радуга)", "default": false },
    { "id": "chroma_speed", "type": "float", "name": "Скорость радуги", "min": 0.5, "max": 5.0, "default": 2.0, "control": "slider" },
    { "id": "enable_trail", "type": "bool", "name": "Включить трейл", "default": true },
    { "id": "trail_texture", "type": "choice", "name": "Текстура трейла", "default": "bubbles", "options": ["bubbles", "fire", "stars", "hearts", "rainbow"] },
    { "id": "trail_width", "type": "float", "name": "Ширина трейла", "min": 0.1, "max": 2.0, "default": 0.5, "control": "slider" },
    { "id": "trail_time", "type": "float", "name": "Время жизни трейла", "min": 0.1, "max": 3.0, "default": 1.0, "control": "slider" },
    { "id": "custom_fov", "type": "float", "name": "FOV", "min": 60.0, "max": 110.0, "default": 75.0, "control": "slider" }
  ],
  "hud": [
    { "label": "Хрома скин", "setting": "enable_chroma", "action": "toggle", "pos": "right" },
    { "label": "Трейл", "setting": "enable_trail", "action": "toggle", "pos": "right" }
  ]
}
