      "min": 0.1,
      "max": 3.0,
      "default": 1.0,
      "control": "slider"
    },
    {
      "id": "trail_smooth",
      "type": "bool",
      "name": "Плавный трейл",
      "default": true
    },
    {
      "id": "enable_fov",
      "type": "bool",
      "name": "Свой FOV",
      "default": false
