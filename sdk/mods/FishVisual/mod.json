{
  "id": "fish-visuals",
  "name": "FishVisuals",
  "version": "1.16.1",
  "author": "Normal48",
  "description": "Визуалы: хрома, трейл, FOV, небо, slo-mo, безумие, кинокамера, спутники, цветокор, цветной свет",
  "libs": [
    "libs/arm64-v8a/libfishvisuals.so"
  ],
  "settings": [
    {
      "id": "selftest",
      "type": "bool",
      "name": "!!! SELFTEST (форсит красную хрому/зелёный трейл/голову/FOV)",
      "default": false
    },
    {
      "id": "enable_chroma",
      "type": "bool",
      "name": "Хрома-скин (Радуга)",
      "default": false
    },
    {
      "id": "chroma_speed",
      "type": "float",
      "name": "Скорость радуги",
      "min": 0.5,
      "max": 5.0,
      "default": 2.0,
      "control": "slider"
    },
    {
      "id": "chroma_strobe",
      "type": "bool",
      "name": "Стробоскоп хромы",
      "default": false
    },
    {
      "id": "enable_trail",
      "type": "bool",
      "name": "Трейл",
      "default": true
    },
    {
      "id": "trail_texture",
      "type": "choice",
      "name": "Текстура трейла",
      "default": "bubbles",
      "options": [
        "bubbles",
        "fire",
        "stars",
        "hearts",
        "rainbow"
      ]
    },
    {
      "id": "trail_width",
      "type": "float",
      "name": "Ширина трейла",
      "min": 0.1,
      "max": 2.0,
      "default": 0.5,
      "control": "slider"
    },
    {
      "id": "trail_time",
      "type": "float",
